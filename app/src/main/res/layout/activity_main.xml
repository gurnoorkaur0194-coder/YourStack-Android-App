<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#171719">

    <!-- TOP HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:gravity="center_vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▤"
            android:textColor="#D17A4B"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/searchButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⌕"
            android:textColor="#F2EDE8"
            android:textSize="34sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/profileButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:background="@drawable/ui_avatar"
            android:text="G"
            android:textColor="#F2EDE8"
            android:textSize="18sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- SCROLLABLE HOME CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- STORIES -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="165dp"
                android:scrollbars="none"
                android:fillViewport="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingLeft="16dp"
                    android:paddingRight="10dp">

                    <!-- Story 1 -->
                    <LinearLayout
                        android:layout_width="92dp"
                        android:layout_height="125dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="78dp"
                            android:layout_height="78dp"
                            android:gravity="center"
                            android:background="#55483B"
                            android:text="🌿"
                            android:textSize="35sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center"
                            android:text="all that i am..."
                            android:textColor="#B8AEA7"
                            android:textSize="12sp"
                            android:maxLines="1" />
                    </LinearLayout>

                    <!-- Story 2 -->
                    <LinearLayout
                        android:layout_width="92dp"
                        android:layout_height="125dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="78dp"
                            android:layout_height="78dp"
                            android:gravity="center"
                            android:background="#66513D"
                            android:text="🎭"
                            android:textSize="35sp" />

                        <TextView
                            android:id="@+id/bakeSamosaStory"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center"
                            android:text="bakesamosa"
                            android:textColor="#B8AEA7"
                            android:textSize="12sp"
                            android:maxLines="1" />
                    </LinearLayout>

                    <!-- Story 3 -->
                    <LinearLayout
                        android:layout_width="92dp"
                        android:layout_height="125dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="78dp"
                            android:layout_height="78dp"
                            android:gravity="center"
                            android:background="#263F55"
                            android:text="📰"
                            android:textSize="35sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center"
                            android:text="People and Policy"
                            android:textColor="#B8AEA7"
                            android:textSize="12sp"
                            android:maxLines="1" />
                    </LinearLayout>

                    <!-- Story 4 -->
                    <LinearLayout
                        android:layout_width="92dp"
                        android:layout_height="125dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="78dp"
                            android:layout_height="78dp"
                            android:gravity="center"
                            android:background="#272B67"
                            android:text="🌌"
                            android:textSize="35sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center"
                            android:text="Unmapped Stories"
                            android:textColor="#B8AEA7"
                            android:textSize="12sp"
                            android:maxLines="1" />
                    </LinearLayout>


                </LinearLayout>
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#302D2B" />

            <!-- NEWLY PUBLISHED POSTS WILL APPEAR HERE -->

            <LinearLayout
                android:id="@+id/userPostsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <!-- POST 1 -->
            <LinearLayout
                android:id="@+id/postAndrewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Author -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="43dp"
                        android:layout_height="43dp"
                        android:gravity="center"
                        android:background="#55534A"
                        android:text="A"
                        android:textColor="#F2EDE8"
                        android:textStyle="bold"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingLeft="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Andrew"
                            android:textColor="#F2EDE8"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="2d  ·  Subscribe"
                            android:id="@+id/subscribeAndrew"
                            android:textColor="#D17A4B"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="35dp"
                        android:layout_height="wrap_content"
                        android:text="•••"
                        android:gravity="center"
                        android:textColor="#918781"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Post text -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="I came across this today and had to share it:"
                    android:textColor="#F2EDE8"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="The trick to put your phone down from monks."
                    android:textColor="#F2EDE8"
                    android:textSize="19sp"
                    android:lineSpacingExtra="3dp" />

                <!-- Post image placeholder -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="330dp"
                    android:layout_marginTop="15dp"
                    android:background="#B5A185">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="25dp"
                        android:text="Brother, why can't I put my phone down?\n\n\n🧑🏻‍🦱                 🧔🏻"
                        android:textColor="#382C23"
                        android:textSize="21sp"
                        android:fontFamily="serif"
                        android:textStyle="bold" />
                </FrameLayout>


                <!-- ENGAGEMENT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/likeButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="♡  3.1k"
                        android:textColor="#B8AEA7"
                        android:textSize="15sp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/commentButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="▢  34"
                        android:textColor="#B8AEA7"
                        android:textSize="15sp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⟳  408"
                        android:textColor="#B8AEA7"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="♧"
                        android:textColor="#B8AEA7"
                        android:textSize="20sp"/>
                </LinearLayout>

                <!-- COMMENT SECTION -->
                <LinearLayout
                    android:id="@+id/commentArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/commentDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#F2EDE8"
                        android:textSize="14sp"
                        android:padding="8dp"/>

                    <EditText
                        android:id="@+id/commentInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Write a comment..."
                        android:textColor="#F2EDE8"
                        android:textColorHint="#A69C95"
                        android:background="@drawable/ui_soft_button"
                        android:padding="12dp"
                        android:inputType="textCapSentences|textMultiLine"/>

                    <TextView
                        android:id="@+id/postComment"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:paddingLeft="18dp"
                        android:paddingRight="18dp"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/ui_orange_pill"
                        android:text="Post comment"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#302D2B" />

                <!-- POST 4 -->
                <LinearLayout
                    android:id="@+id/postThinkingCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="THE THINKING ROOM"
                        android:textColor="#D17A4B"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="The internet made us more connected, but are we less understood?"
                        android:textColor="#F2EDE8"
                        android:textSize="22sp"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="An exploration of digital friendships, attention and the changing meaning of connection."
                        android:textColor="#B8AEA7"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:gravity="center_vertical"
                        android:text="♡  1.2k          ▢  89          ⟳  74"
                        android:textColor="#B8AEA7"
                        android:textSize="15sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#302D2B" />

                <!-- POST 5 -->
                <LinearLayout
                    android:id="@+id/postLettersCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LETTERS TO MYSELF"
                        android:textColor="#D17A4B"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="A reminder that you don't have to have everything figured out."
                        android:textColor="#F2EDE8"
                        android:textSize="22sp"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="You are allowed to change your mind, start again and take your time."
                        android:textColor="#B8AEA7"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:gravity="center_vertical"
                        android:text="♡  876          ▢  53          ⟳  31"
                        android:textColor="#B8AEA7"
                        android:textSize="15sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#302D2B" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#302D2B" />

            <!-- POST 2 -->
            <LinearLayout
                android:id="@+id/postRithanyaCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RITHANYA S"
                    android:textColor="#B8AEA7"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Sometimes, the smallest things stay with us the longest."
                    android:textColor="#F2EDE8"
                    android:textSize="20sp"
                    android:fontFamily="serif"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="A collection of thoughts, memories and little moments from everyday life."
                    android:textColor="#B8AEA7"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:gravity="center_vertical"
                    android:text="♡  245             ▢  18             ⟳  12"
                    android:textColor="#B8AEA7"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#302D2B" />

        </LinearLayout>
    </ScrollView>


    <!-- CREATE POST BUTTON -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:padding="12dp">

        <TextView
            android:id="@+id/createPostButton"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:gravity="center"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:text="＋  Write"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/ui_orange_pill"
            android:elevation="6dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>


    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#171719"
        android:elevation="8dp">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nHome"
            android:textColor="#F2EDE8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />


        <TextView
            android:id="@+id/navPodcasts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♫\nPodcasts"
            android:textColor="#918781"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▢\nChat"
            android:textColor="#918781"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navActivity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♧\nActivity"
            android:textColor="#918781"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
