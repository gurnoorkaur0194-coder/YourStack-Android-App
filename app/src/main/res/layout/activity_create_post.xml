<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#171719"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cancelPost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#B8AEA7"
            android:textSize="16sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="New post"
            android:textColor="#F2EDE8"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/publishPost"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:gravity="center"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:text="Publish"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/ui_orange_pill"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Share something with the world."
        android:textColor="#AAA19B"
        android:textSize="14sp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="22dp"/>

    <EditText
        android:id="@+id/postTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Give your post a title..."
        android:textColor="#F2EDE8"
        android:textColorHint="#77716D"
        android:textSize="25sp"
        android:textStyle="bold"
        android:background="@android:color/transparent"
        android:padding="8dp"
        android:inputType="textCapSentences"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#393537"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"/>

    <EditText
        android:id="@+id/postContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top"
        android:hint="Start writing your thoughts..."
        android:textColor="#E8E1DC"
        android:textColorHint="#77716D"
        android:textSize="17sp"
        android:lineSpacingExtra="7dp"
        android:background="@android:color/transparent"
        android:padding="8dp"
        android:inputType="textCapSentences|textMultiLine"
        android:minLines="8"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Made for your thoughts. ✨"
        android:textColor="#77716D"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="12dp"/>

</LinearLayout>
