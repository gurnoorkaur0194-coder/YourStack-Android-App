<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#171719">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:gravity="center_vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp">

        <TextView
            android:id="@+id/profileBack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#F2EDE8"
            android:textSize="32sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Profile"
            android:textColor="#F2EDE8"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•••"
            android:textColor="#F2EDE8"
            android:textSize="22sp"/>
    </LinearLayout>

    <!-- SCROLLABLE PROFILE CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- COVER -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:background="#493B35">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✦     STORIES &amp; THOUGHTS     ✦"
                    android:textColor="#D8BBA8"
                    android:textSize="17sp"
                    android:letterSpacing="0.08"/>
            </FrameLayout>

            <!-- PROFILE DETAILS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingRight="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="85dp"
                        android:layout_height="85dp"
                        android:gravity="center"
                        android:background="@drawable/ui_orange_pill"
                        android:text="G"
                        android:textColor="#F2EDE8"
                        android:textSize="38sp"
                        android:textStyle="bold"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/editProfile"
                        android:layout_width="115dp"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:background="#302D2B"
                        android:text="Edit profile"
                        android:textColor="#F2EDE8"
                        android:textSize="13sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gurnoor Kaur"
                    android:textColor="#F2EDE8"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:paddingTop="13dp"/>

                <TextView
                    android:id="@+id/profileUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="gurnoorkaur0194"
                    android:textColor="#A69C95"
                    android:textSize="13sp"
                    android:paddingTop="4dp"/>

                <TextView
                    android:id="@+id/profileBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Collecting thoughts, stories and little things that make life interesting. ✨"
                    android:textColor="#DDDDDD"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:paddingTop="13dp"/>

                <TextView
                    android:id="@+id/profileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✉  gurnoor@example.com"
                    android:textColor="#A69C95"
                    android:textSize="12sp"
                    android:paddingTop="10dp"/>

                <!-- FOLLOWER COUNTS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="128 "
                        android:textColor="#F2EDE8"
                        android:textStyle="bold"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Following"
                        android:textColor="#A69C95"
                        android:textSize="13sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="     246 "
                        android:textColor="#F2EDE8"
                        android:textStyle="bold"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Followers"
                        android:textColor="#A69C95"
                        android:textSize="13sp"/>
                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#302D2B"/>

            <!-- PROFILE TABS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Posts"
                    android:textColor="#D17A4B"
                    android:textStyle="bold"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="About"
                    android:textColor="#A69C95"
                    android:textSize="14sp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#302D2B"/>

            <!-- POST 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OCTOBER 28 · 4 MIN READ"
                    android:textColor="#D17A4B"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="The beauty of starting over"
                    android:textColor="#F2EDE8"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:paddingTop="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sometimes a new beginning isn't a big dramatic moment. Sometimes it's just deciding to try again."
                    android:textColor="#B8AEA7"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:paddingTop="7dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="♡  24       ◯  6"
                    android:textColor="#918781"
                    android:textSize="12sp"
                    android:paddingTop="14dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#302D2B"/>

            <!-- POST 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OCTOBER 21 · 3 MIN READ"
                    android:textColor="#D17A4B"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A quiet life is a beautiful life"
                    android:textColor="#F2EDE8"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:paddingTop="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Not every meaningful moment needs an audience. Some of the best memories are the ones we keep to ourselves."
                    android:textColor="#B8AEA7"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:paddingTop="7dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="♡  41       ◯  9"
                    android:textColor="#918781"
                    android:textSize="12sp"
                    android:paddingTop="14dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#171719">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nHome"
            android:textColor="#918781"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navPodcasts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♫\nPodcasts"
            android:textColor="#918781"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▢\nChat"
            android:textColor="#918781"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navActivity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♡\nActivity"
            android:textColor="#918781"
            android:textSize="12sp"/>
    </LinearLayout>

</LinearLayout>
