<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#171719">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Podcasts"
            android:textColor="#F2EDE8"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⌕"
            android:textColor="#F2EDE8"
            android:textSize="30sp"/>
    </LinearLayout>

    <!-- INTRO -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Listen to something interesting."
        android:textColor="#B8AEA7"
        android:textSize="14sp"
        android:paddingLeft="20dp"
        android:paddingBottom="16dp"/>

    <!-- SCROLLABLE PODCAST LIST -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <!-- SECTION TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUR DAILY LISTEN"
                android:textColor="#D17A4B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingBottom="14dp"/>

            <!-- PODCAST 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:gravity="center"
                    android:background="#493C50"
                    android:text="☀"
                    android:textSize="32sp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingLeft="13dp">

                    <TextView
                        android:text="The Daily Pause"
                        android:textColor="#F2EDE8"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Finding peace in a noisy world · 24 min"
                        android:textColor="#A69C95"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#F2EDE8"
                    android:textSize="19sp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#302D2B"/>

            <!-- PODCAST 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:gravity="center"
                    android:background="#514638"
                    android:text="☕"
                    android:textSize="32sp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingLeft="13dp">

                    <TextView
                        android:text="Conversations Over Coffee"
                        android:textColor="#F2EDE8"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Why we love the stories we tell · 38 min"
                        android:textColor="#A69C95"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#F2EDE8"
                    android:textSize="19sp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#302D2B"/>

            <!-- PODCAST 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:gravity="center"
                    android:background="#354B50"
                    android:text="🌊"
                    android:textSize="32sp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingLeft="13dp">

                    <TextView
                        android:text="The Long Way Around"
                        android:textColor="#F2EDE8"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Lessons from unexpected journeys · 31 min"
                        android:textColor="#A69C95"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#F2EDE8"
                    android:textSize="19sp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#302D2B"/>

            <!-- PODCAST 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:gravity="center"
                    android:background="#51404A"
                    android:text="🌙"
                    android:textSize="32sp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingLeft="13dp">

                    <TextView
                        android:text="Midnight Musings"
                        android:textColor="#F2EDE8"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="On growing up and letting go · 19 min"
                        android:textColor="#A69C95"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#F2EDE8"
                    android:textSize="19sp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#302D2B"/>

            <!-- PODCAST 5 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:gravity="center"
                    android:background="#4B4D35"
                    android:text="🌱"
                    android:textSize="32sp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingLeft="13dp">

                    <TextView
                        android:text="Small Things, Big Ideas"
                        android:textColor="#F2EDE8"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="A different way to see everyday life · 27 min"
                        android:textColor="#A69C95"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#F2EDE8"
                    android:textSize="19sp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#302D2B"/>

            <!-- PODCAST 6 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:gravity="center"
                    android:background="#45405A"
                    android:text="🎧"
                    android:textSize="32sp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingLeft="13dp">

                    <TextView
                        android:text="Between the Lines"
                        android:textColor="#F2EDE8"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Books, culture and everything between · 42 min"
                        android:textColor="#A69C95"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#F2EDE8"
                    android:textSize="19sp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#302D2B"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="You're all caught up."
                android:textColor="#817770"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="25dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#171719"
        android:elevation="10dp">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nHome"
            android:textColor="#918781"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navPodcasts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♫\nPodcasts"
            android:textColor="#D17A4B"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▢\nChat"
            android:textColor="#918781"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navActivity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♡\nActivity"
            android:textColor="#918781"
            android:textSize="12sp"/>
    </LinearLayout>

</LinearLayout>
