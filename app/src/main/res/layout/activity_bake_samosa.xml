<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#171719">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp">

        <TextView
            android:id="@+id/bakeBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹  Back"
            android:textColor="#E8E1D8"
            android:textSize="16sp"
            android:padding="8dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="the daily"
            android:textColor="#C4510C"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- PROFILE SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:gravity="center"
                    android:background="#C4510C"
                    android:text="b"
                    android:textColor="#FFFFFF"
                    android:textSize="42sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="bakesamosa"
                        android:textColor="#F5F0E8"
                        android:textSize="24sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="bakesamosa·2"
                        android:textColor="#A9A29A"
                        android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- BIO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="27 year old, lawyer and self-proclaimed nostalgia merchant, communicating in pictures and puns, longform content occasionally, learning to be more grateful."
                android:textColor="#E8E1D8"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Drop an email: bakesamosainnit@gmail.com"
                android:textColor="#C4510C"
                android:textSize="13sp"/>

            <!-- SUBSCRIBER DETAILS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1.4K+ subscribers"
                    android:textColor="#F5F0E8"
                    android:textStyle="bold"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="41 publications"
                    android:textColor="#A9A29A"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- SUBSCRIBE -->
            <Button
                android:id="@+id/bakeSubscribe"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:text="Subscribe"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#C4510C"/>

            <!-- TABS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Notes"
                    android:textColor="#F5F0E8"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:layout_marginStart="25dp"
                    android:text="About"
                    android:textColor="#88817A"
                    android:textSize="15sp"/>
            </LinearLayout>

            <View
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:background="#C4510C"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#393638"/>

            <!-- NOTES CONTAINER -->
            <LinearLayout
                android:id="@+id/bakeNotesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="10dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
